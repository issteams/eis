# EIS production configuration example.
# Do not put credentials, API keys, or tokens in this file.
EIS_ENVIRONMENT=production
EIS_SERVICE_NAME=eis
EIS_LOG_JSON=true
EIS_LOG_LEVEL=INFO
EIS_REQUEST_TIMEOUT_SECONDS=30
EIS_MODEL_TIMEOUT_SECONDS=120
EIS_TOOL_TIMEOUT_SECONDS=120
EIS_MAX_RETRIES=2
EIS_RETRY_BACKOFF_SECONDS=0.5
EIS_WORKER_CONCURRENCY=4
EIS_MAX_CONCURRENT_TASKS=4
EIS_QUEUE_NAME=eis
EIS_TASK_LEASE_SECONDS=300
EIS_TASK_RECOVERY_INTERVAL_SECONDS=30
EIS_MAX_TASK_ATTEMPTS=3
EIS_HEALTH_TIMEOUT_SECONDS=2
EIS_PERSISTENCE_PATH=/var/lib/eis/jobs.sqlite3
EIS_METRICS_ENABLED=true
