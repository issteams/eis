# EIS runtime
EIS_ENVIRONMENT=development
EIS_RUNTIME_NAME=eis
EIS_LOG_LEVEL=INFO

# Model capability configuration
# Leave provider as `none` when no external model adapter is configured.
# Supported built-ins: fake, openrouter, cloudflare.
EIS_MODEL_PROVIDER=none
EIS_MODEL_NAME=
EIS_MODEL_BASE_URL=
# Never commit a real API key. Set EIS_MODEL_API_KEY only in the runtime environment.
EIS_MODEL_API_KEY=
EIS_MODEL_TIMEOUT=60
EIS_MODEL_MAX_ATTEMPTS=3

# Cloudflare Workers AI
# Required only when EIS_MODEL_PROVIDER=cloudflare.
EIS_CLOUDFLARE_ACCOUNT_ID=
# Optional AI Gateway ID. Workers AI requests through AI Gateway require this header.
EIS_CLOUDFLARE_GATEWAY_ID=

# Provider-neutral capability declarations
EIS_EMBEDDING_PROVIDER=none
EIS_REPOSITORY_PROVIDER=none
EIS_KNOWLEDGE_BACKEND=none
EIS_MAX_TOOL_CALLS=20
